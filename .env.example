# ─── Telegram Bot ────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
HANDLE=@thiagaoai
# Comma-separated Telegram user IDs allowed to use the bot (empty = all)
ALLOWED_USERS=

# ─── Image Generation (fal.ai — primary) ─────────
FAL_KEY=your_fal_key_here

# ─── Image Generation (Replicate — fallback) ─────
REPLICATE_API_TOKEN=your_replicate_token_here

# ─── Content Research ────────────────────────────
TAVILY_API_KEY=your_tavily_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ─── Instagram Posting (postforme.dev) ───────────
POSTFORME_API_KEY=your_postforme_key_here
POSTFORME_IG_ID=your_instagram_business_id_here

# ─── Railway ─────────────────────────────────────
PORT=8080
