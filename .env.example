# ─── Telegram Bot ────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
HANDLE=@thiagaoai
# Comma-separated Telegram user IDs allowed to use the bot (empty = all)
ALLOWED_USERS=

# ─── Image Generation (fal.ai — primary) ─────────
FAL_KEY=your_fal_key_here

# ─── Image Generation (Replicate — fallback) ─────
REPLICATE_API_TOKEN=your_replicate_token_here

# ─── Content Research ────────────────────────────
TAVILY_API_KEY=your_tavily_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ─── Instagram Posting (postforme.dev) ───────────
POSTFORME_API_KEY=your_postforme_key_here
POSTFORME_IG_ID=your_instagram_business_id_here

# ─── Supabase (job log + /historico) ─────────────
# Leave empty to disable — bot falls back to in-memory only.
# Use the `service_role` key if you want writes to bypass RLS, or
# the `anon` key plus a permissive RLS policy. For a single-operator
# bot running on Railway, service_role is fine.
SUPABASE_URL=
SUPABASE_KEY=

# ─── Railway ─────────────────────────────────────
PORT=8080
# RAILWAY_PUBLIC_DOMAIN is auto-injected by Railway when deployed.
# Presence flips the bot from polling → webhook mode.
